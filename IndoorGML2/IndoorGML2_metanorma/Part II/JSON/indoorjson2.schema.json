{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.indoorgml.org/schemas/indoorjson/0.1/indoorjson2.schema.json",
  "title": "IndoorJSON for IndoorGML 2.0 core part",
  "description": "IndoorJSON",
  "definitions": {

    "ThematicLayer": {
      "$anchor": "ThematicLayer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "featureType": { "enum": ["ThematicLayer"] },
        "semanticExtension": { "type": "boolean" },
        "theme": { "enum": ["Virtual", "Physical", "Tags", "Unknown"] },
        "primalSpace": { "$ref": "#/definitions/PrimalSpaceLayer" },
        "dualSpace": { "$ref": "#/definitions/DualSpaceLayer" }
      },
      "additionalProperties": false,
      "required": ["id","featureType","semanticExtension","theme"]
    },

    "PrimalSpaceLayer": {
      "$anchor": "PrimalSpaceLayer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "featureType": { "enum": ["PrimalSpaceLayer"] },
        "creationDatetime": { "type": "string", "format": "date-time" },
        "terminationDatetime": { "type": "string", "format": "date-time" },
        "cellSpaceMember": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/CellSpace" }
        },
        "cellBoundaryMember": {
          "type": "array",
          "items": { "$ref": "#/definitions/CellBoundary" }
        }
      },
      "required": ["featureType","cellSpaceMember"]
    },

    "CellSpace": {
      "$anchor": "CellSpace",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "featureType": { "enum": ["CellSpace"] },
        "level": { "type": "string" },
        "poi": { "type":  "boolean" },
        "duality" : { "type": "string" },
        "cellSpaceGeom" : {
          "oneOf": [
            { "$ref": "geometry-object.json#/$defs/Polyhedron" },
            { "$ref": "geometry-object.json#/$defs/Prism" },
            { "$ref": "geometry-object.json#/$defs/Polygon" },
            { "$ref": "geometry-object.json#/$defs/CurvePolygon" }
          ]
        },
        "boundedBy": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "required": ["id","featureType","poi"]
    },

    "CellBoundary": {
      "$anchor": "CellBoundary",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "featureType": { "enum": ["CellBoundary"] },
        "isVirtual": { "type":  "boolean" },
        "duality" : { "type": "string" },
        "cellBoundaryGeom" : {
          "oneOf": [
            { "$ref": "geometry-object.json#/$defs/Polygon" },
            { "$ref": "geometry-object.json#/$defs/CurvePolygon" },
            { "$ref": "geometry-object.json#/$defs/LineString" },
            { "$ref": "geometry-object.json#/$defs/CircularString" },
            { "$ref": "geometry-object.json#/$defs/CompoundCurve" }
          ]
        }
      },
      "required": ["id","featureType","isVirtual"]
    },

    "DualSpaceLayer": {
      "$anchor": "DualSpaceLayer",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "featureType": { "enum": ["DualSpaceLayer"] },
        "creationDatetime": { "type": "string", "format": "date-time" },
        "terminationDatetime": { "type": "string", "format": "date-time" },
        "isLogical": { "type": "boolean" },
        "isDirected": { "type": "boolean" },
        "nodeMember": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/Node" }
        },
        "edgeMember": {
          "type": "array",
          "items": { "$ref": "#/definitions/Edge" }
        }
      },
      "required": ["featureType","isLogical","isDirected","nodeMember"]
    },

    "Node": {
      "$anchor": "Node",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "featureType": { "enum": ["Node"] },
        "duality" : { "type": "string" },
        "geometry" : { "$ref": "geometry-object.json#/$defs/Point" },
        "connects" : {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      },
      "required": ["id","featureType","duality"]
    },

    "Edge": {
      "$anchor": "Edge",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "featureType": { "enum": ["Edge"] },
        "duality" : { "type": "string" },
        "weight" : { "type": "number" },
        "geometry" : {
          "oneOf": [
            { "$ref": "geometry-object.json#/$defs/LineString" },
            { "$ref": "geometry-object.json#/$defs/CircularString" },
            { "$ref": "geometry-object.json#/$defs/CompoundCurve" }
          ]
        },
        "connects" : {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "maximum": 2,
          "uniqueItems": true
        }
      },
      "required": ["id","featureType","weight","connects"]
    },

    "InterLayerConnection": {
      "$anchor": "InterLayerConnection",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "featureType": { "enum": ["InterLayerConnection"] },
        "connectedLayers": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "maximum": 2,
          "uniqueItems": true
        },
        "connectedNodes" : {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "maximum": 2,
          "uniqueItems": true
        },
        "connectedCells" : {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 2,
          "maximum": 2,
          "uniqueItems": true
        },
        "typeOfTopoExpression" : {
          "enum": ["CONTAINS", "OVERLAPS", "EQUALS", "WITHIN", "CROSSES", "OTHERS"]
        },
        "comment" : {"type": "string"}
      },
      "additionalProperties": false,
      "required": ["featureType","connectedLayers","typeOfTopoExpression"]
    }
  },


  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "featureType": { "enum": ["IndoorFeatures"] },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/ThematicLayer" }
    },
    "layerConnections": {
      "type": "array",
      "items": { "$ref": "#/definitions/InterLayerConnection" }
    }
  },
  "required": ["featureType","layers"]
}

