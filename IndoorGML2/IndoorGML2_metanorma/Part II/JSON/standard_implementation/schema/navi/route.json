{
  "Route": {
    "$anchor": "Route",
    "type": "object",
    "properties": {
      "creationDate": { "type": "string", "format": "date-time"},
      "routeNode": {
        "type": "array",
        "minItems": 2,
        "items": {"$ref": "indoorjson.core.schema.json#/$defs/Node"}
      },
      "routeEdge": {
        "type": "array",
        "minItems": 1,
        "items": {"$ref": "indoorjson.core.schema.json#/$defs/Edge"}
      }
    },
    "required": ["routeNode","routeEdge"]
  }
}